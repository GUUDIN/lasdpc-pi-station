[Unit]
Description=LASDPC Station - backup de configuração
After=network.target

[Service]
Type=oneshot
User=lasdpc
ExecStartPre=/bin/bash -c 'mkdir -p /var/log/lasdpc && chown lasdpc:lasdpc /var/log/lasdpc 2>/dev/null || true'
ExecStart=/usr/local/bin/lasdpc-backup.sh
StandardOutput=append:/var/log/lasdpc/backup.log
StandardError=append:/var/log/lasdpc/backup.log
