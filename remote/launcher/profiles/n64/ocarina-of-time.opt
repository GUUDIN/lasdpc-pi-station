# The Legend of Zelda: Ocarina of Time (NTSC/PAL, todas as revisoes).
# match: THE LEGEND OF ZELDA
# Emulacao de framebuffer e obrigatoria: o fundo do menu de pausa e a pedra do
# Lens/oclusao do sol leem a imagem renderizada de volta para a RAM do N64.
# Validado: menu de pausa ok; 90-116 fps sem limite nas 13 areas abertas testadas
# (Kakariko e a mais pesada: 90).
mupen64plus-EnableFBEmulation = "True"
mupen64plus-EnableCopyColorToRDRAM = "Async"
mupen64plus-EnableCopyDepthToRDRAM = "Software"
