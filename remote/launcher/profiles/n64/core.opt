# Mupen64Plus-Next (GLideN64 GLES3) — base afinada para o Pi 4 (V3D @ 500 MHz).
# Medido em 2026-10-02 com Zelda OoT, sem limitador (60 = velocidade real), via
# tools/n64-bench. Kakariko (pior area): 640x480 padrao 47 fps -> 320x240 75 ->
# 320x240 + ThreadedRenderer 94. Em 13 areas o padrao fica em 47-68 (lento) e esta
# base em 90-116. Gargalo: fill rate da V3D + thread principal do emulador.
mupen64plus-rdp-plugin = "gliden64"
mupen64plus-rsp-plugin = "hle"
mupen64plus-cpucore = "dynamic_recompiler"
mupen64plus-43screensize = "320x240"
mupen64plus-EnableNativeResFactor = "0"
mupen64plus-ThreadedRenderer = "True"
mupen64plus-MultiSampling = "0"
mupen64plus-FXAA = "0"
