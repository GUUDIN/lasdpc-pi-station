#!/usr/bin/env bash
# ============================================================
# lasdpc-soloist-setkey — configura a chave de API do Spotify Soloist.
#   sudo lasdpc-soloist-setkey               digita a chave (sem aparecer na tela)
#   sudo lasdpc-soloist-setkey --de ESTACAO  copia de outra estacao da rede (nome ou IP);
#                                            ela aprova na TV (ou com "Permitir
#                                            compartilhar" ligado em Ajustes)
#   sudo lasdpc-soloist-setkey --procurar    copia da primeira estacao com chave achada
# Gere a chave em https://developer.spotify.com/dashboard/soloist (conta Premium).
# O mesmo esta no menu: Ajustes -> Spotify -> "Copiar chave de outra estacao".
# ============================================================
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "rode com sudo"; exit 1; }
KEYSHARE=/opt/lasdpc-pi-station/launcher/keyshare.py

case "${1:-}" in
  --de)       [ -n "${2:-}" ] || { echo "uso: sudo lasdpc-soloist-setkey --de ESTACAO"; exit 2; }
              exec python3 "$KEYSHARE" fetch "$2" ;;
  --procurar) exec python3 "$KEYSHARE" fetch ;;
  "")         ;;
  *)          sed -n '3,10p' "$0"; exit 2 ;;
esac

read -r -s -p "Chave de API do Spotify Soloist: " KEY; echo
[ -n "$KEY" ] || { echo "chave vazia"; exit 1; }
printf '%s\n' "$KEY" | LASDPC_USER="${SUDO_USER:-}" /usr/local/bin/lasdpc-soloist-key set
sleep 3
systemctl is-active lasdpc-soloist.service >/dev/null && echo "Soloist ativo: escolha 'TV LASDPC' no app do Spotify."
