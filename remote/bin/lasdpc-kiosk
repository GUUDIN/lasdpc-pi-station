#!/usr/bin/env bash
# ============================================================
# lasdpc-kiosk <URL> — abre o Chromium em modo kiosk (Wayland/labwc).
# Aguarda rede+DNS, usa página de fallback local se a URL estiver indisponível,
# perfil dedicado, sem mensagens de primeira execução, anti-suspensão de tela.
# Sai quando o Chromium fecha (o lasdpc-session decide relançar).
# ============================================================
set -u
URL="${1:-http://localhost:8090}"
# Profile pode ser sobrescrito por env (ex.: modo ytcast usa "chromium-ytcast"
# para nao concorrer pelo mesmo SingletonLock do menu/dashboard ao trocar de
# modo, o que estava jogando a sessao em backoff -> menu).
PROFILE="${HOME}/.config/lasdpc/${LASDPC_KIOSK_PROFILE:-chromium-kiosk}"
FALLBACK="file://${HOME}/.config/lasdpc/fallback.html"
ESCAPE_EXTENSION="/opt/lasdpc-pi-station/kiosk/escape-extension"
mkdir -p "$PROFILE"

# Remove locks orfaos de uma instancia anterior encerrada abruptamente (SIGTERM
# do lasdpc-mode ao trocar de modo). O Chromium recusa subir num profile com
# SingletonLock vivo e sai na hora; como o lasdpc-session garante UMA instancia
# kiosk por vez, limpar aqui evita o sintoma "entra, volta ao menu, so funciona
# na 2a vez" (a 1a tentativa morria no lock e caia no backoff).
rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket" 2>/dev/null || true

# Detecta o binário do Chromium
CHROME=""
for c in chromium chromium-browser; do command -v "$c" >/dev/null 2>&1 && { CHROME="$c"; break; }; done
[ -n "$CHROME" ] || { logger -t lasdpc-kiosk "Chromium não encontrado"; sleep 5; exit 1; }

# Espera rede+DNS por até ~30s; se falhar, abre fallback
target="$URL"
ok=0
for i in $(seq 1 15); do
  host="$(echo "$URL" | sed -E 's#^[a-z]+://([^/:]+).*#\1#')"
  if getent hosts "$host" >/dev/null 2>&1 || [ "$host" = "localhost" ]; then ok=1; break; fi
  sleep 2
done
[ "$ok" = 1 ] || { logger -t lasdpc-kiosk "rede/DNS indisponível p/ $URL — usando fallback"; target="$FALLBACK"; }

CHROME_ARGS=(
  --ozone-platform=wayland
  --user-data-dir="$PROFILE"
  --load-extension="$ESCAPE_EXTENSION"
  --kiosk "$target"
  --start-fullscreen
  --noerrdialogs
  --disable-infobars
  --disable-session-crashed-bubble
  --disable-translate
  --disable-features=Translate,TranslateUI
  --lang=pt-BR
  --accept-lang=pt-BR,pt,en-US,en
  --no-first-run
  --fast --fast-start
  --no-default-browser-check
  --check-for-update-interval=31536000
  --overscroll-history-navigation=0
  --autoplay-policy=no-user-gesture-required
  --password-store=basic
)

logger -t lasdpc-kiosk "abrindo $target"

# Impede suspensão/blank de tela quando a sessão permite, via systemd-inhibit.
# IMPORTANTE: usamos exec, então o lasdpc-kiosk É SUBSTITUIDO pelo Chromium e
# sai com o codigo de saida dele. Quem decide relançar (ou trocar de modo) é o
# lasdpc-session. A versao anterior fazia `systemd-inhibit ... && exit 0` seguido
# de um exec de fallback: quando o lasdpc-mode matava o Chromium (SIGTERM, exit
# 143) ao trocar de modo, o `&&` nao disparava e o fallback RELANÇAVA o mesmo
# Chromium (o menu) — causando o "volta pro menu e so depois abre".
if command -v systemd-inhibit >/dev/null 2>&1; then
  exec systemd-inhibit --what=idle:sleep:handle-lid-switch --why=lasdpc-kiosk --mode=block "$CHROME" "${CHROME_ARGS[@]}"
fi

exec "$CHROME" "${CHROME_ARGS[@]}"
