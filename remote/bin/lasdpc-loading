#!/usr/bin/env bash
# ============================================================
# lasdpc-loading [mensagem]   — mostra o overlay transitorio fullscreen.
# lasdpc-loading --status TXT — atualiza a etapa exibida ("!TXT" = erro).
# lasdpc-loading --hide       — encerra o overlay.
# Usa mpv com --ontop porque ele fica acima do Chromium kiosk / RetroArch
# fullscreen de forma confiavel. O script loading.lua anima uma barra de
# progresso com a etapa atual e o tempo decorrido, para a tela nunca parecer
# travada. Quem lancou o app (lasdpc-session / lasdpc-retroarch) encerra o
# overlay quando o app de destino esta pronto.
# ============================================================
set -u
CONF="${HOME:-/home/lasdpc}/.config/lasdpc"
PNG="$CONF/loading.png"
STATUS="$CONF/loading_status"
LUA="/opt/lasdpc-pi-station/launcher/loading.lua"
mkdir -p "$CONF"

case "${1:-}" in
  --status)
    printf '%s\n' "${2:-}" > "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
    exit 0 ;;
  --hide)
    # casa pelo comm (mpv/chromium) para nunca matar um shell que so cite o titulo
    ps -u "$(id -u)" -o pid=,comm=,args= | while read -r pid comm args; do
      case "$comm:$args" in
        mpv:*"--title=LASDPC Loading"*|chromium:*"--user-data-dir="*"chromium-loading"*)
          kill "$pid" 2>/dev/null || true ;;
      esac
    done
    exit 0 ;;
esac

MSG="${1:-Carregando}"
: > "$STATUS"
# Com o loading.lua a barra/etapa sao desenhadas ao vivo; o PNG leva so o titulo.
ANIMATED=0
[ -f "$LUA" ] && ANIMATED=1

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

python3 - "$PNG" "$MSG" "$ANIMATED" <<'PY' >/dev/null 2>&1 || true
import sys
from PIL import Image, ImageDraw, ImageFont

out, msg, animated = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
W, H = 1920, 1080
img = Image.new("RGB", (W, H), "#080b0f")
draw = ImageDraw.Draw(img)

def font(size, bold=False):
    paths = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation2/LiberationSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
    ]
    for p in paths:
        try:
            return ImageFont.truetype(p, size)
        except Exception:
            pass
    return ImageFont.load_default()

title_font = font(54, True)
sub_font = font(28)
cx, cy = W // 2, H // 2

draw.ellipse((cx - 54, cy - 154, cx + 54, cy - 46), outline="#f4c542", width=10)
draw.arc((cx - 54, cy - 154, cx + 54, cy - 46), 300, 70, fill="#ffffff", width=10)

texts = [(msg, title_font, cy + 5, "#f6f7f8")]
if not animated:
    texts.append(("Preparando a tela...", sub_font, cy + 82, "#b7c0ca"))
for text, fnt, y, color in texts:
    box = draw.textbbox((0, 0), text, font=fnt)
    draw.text((cx - (box[2] - box[0]) / 2, y), text, font=fnt, fill=color)

img.save(out)
PY

if command -v mpv >/dev/null 2>&1 && [ -s "$PNG" ]; then
  SCRIPT_ARGS=()
  [ "$ANIMATED" = 1 ] && SCRIPT_ARGS=(--script="$LUA")
  # sem OSC/atalhos: teclas e mouse sobre o overlay nao devem fazer nada
  exec mpv --no-terminal --really-quiet --force-window=yes --fullscreen --ontop \
    --no-border --keep-open=yes --loop-file=inf --image-display-duration=inf \
    --no-osc --osd-level=0 --no-input-default-bindings --cursor-autohide=always \
    --title="LASDPC Loading" "${SCRIPT_ARGS[@]}" "$PNG"
fi

# Fallback Chromium se mpv/Pillow falhar.
HTML="/opt/lasdpc-pi-station/launcher/loading.html"
PROFILE="$CONF/chromium-loading"
mkdir -p "$PROFILE"
rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket" 2>/dev/null || true
CHROME=""
for c in chromium chromium-browser; do
  command -v "$c" >/dev/null 2>&1 && { CHROME="$c"; break; }
done
[ -n "$CHROME" ] || exit 0
url="file://${HTML}#$(printf '%s' "$MSG" | sed -e 's/ /%20/g' -e 's/#/%23/g' -e 's/?/%3F/g')"
exec "$CHROME" \
  --ozone-platform=wayland \
  --user-data-dir="$PROFILE" \
  --app="$url" \
  --start-fullscreen \
  --class=LASDPCLoading \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --disable-features=Translate,TranslateUI \
  --lang=pt-BR \
  --accept-lang=pt-BR,pt,en-US,en \
  --no-first-run \
  --fast --fast-start \
  --no-default-browser-check \
  --check-for-update-interval=31536000 \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required \
  --password-store=basic
