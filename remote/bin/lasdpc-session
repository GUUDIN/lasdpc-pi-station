#!/usr/bin/env bash
# ============================================================
# lasdpc-session — runner da sessao grafica (autostart do labwc).
# Le o modo atual (= id de um app, ver apps/<id>/app.json e lasdpc-apps) e mantem
# o app correspondente rodando, com backoff contra crash-loop.
# Cada app roda num scope do systemd --user (lasdpc-app-<id>-N.scope): o
# lasdpc-mode encerra o app parando o scope, o que mata TODOS os processos dele
# (Chromium e filhos, kodi.bin orfao, mpv...), sem tabela de pkill por app.
# Roda DENTRO da sessao Wayland (labwc): tem WAYLAND_DISPLAY/XDG_RUNTIME_DIR.
# ============================================================
set -u
CONF_DIR="${HOME}/.config/lasdpc"
MODE_FILE="$CONF_DIR/mode"
ENV_FILE="$CONF_DIR/session.env"   # DASHBOARD_URL escolhido em Ajustes
mkdir -p "$CONF_DIR"
[ -f "$MODE_FILE" ] || echo "menu" > "$MODE_FILE"

load_env(){
  DASHBOARD_URL="http://localhost:8080"
  [ -f /etc/lasdpc/station.conf ] && . /etc/lasdpc/station.conf
  [ -f "$ENV_FILE" ] && . "$ENV_FILE"
}
log(){ logger -t lasdpc-session "$*" 2>/dev/null; echo "[lasdpc-session] $*"; }
read_mode(){ tr -d '[:space:]' < "$MODE_FILE" 2>/dev/null || echo menu; }
app(){ lasdpc-apps get "$1" "$2" 2>/dev/null; }

hide_loading(){ lasdpc-loading --hide 2>/dev/null || true; }

# Bloqueia ate o modo deixar de ser "$1" (inotify; polling curto de reserva).
wait_until_mode_changes(){
  local from="$1"
  while [ "$(read_mode)" = "$from" ]; do
    if command -v inotifywait >/dev/null 2>&1; then
      inotifywait -qq -t 5 -e modify -e close_write -e move_self "$MODE_FILE" 2>/dev/null || true
    else
      sleep 0.3
    fi
  done
}

# Roda "$@" no scope lasdpc-app-<id>-<n>. TimeoutStopSec=3: quem ignora o
# SIGTERM (ex.: kodi.bin) leva SIGKILL em 3 s ao trocar de modo. O numero vem
# do chamador (o run_scoped roda em segundo plano, num subshell).
run_scoped(){
  local unit="$1"; shift
  systemd-run --user --scope --quiet --collect -p TimeoutStopSec=3 --unit="$unit" -- "$@"
}

SEQ=0
run_app(){
  local id="$1" type url cmd unit
  SEQ=$((SEQ + 1)); unit="lasdpc-app-${id}-${SEQ}"
  type="$(app "$id" launch.type)"
  case "$type" in
    kiosk)
      url="$(app "$id" launch.url)"
      [ "$url" = "@dashboard" ] && url="$DASHBOARD_URL"
      run_scoped "$unit" env LASDPC_KIOSK_PROFILE=chromium-kiosk lasdpc-kiosk "$url" &
      ;;
    command)
      cmd="$(app "$id" launch.command)"
      # shellcheck disable=SC2086
      run_scoped "$unit" $cmd &
      ;;
    *)
      log "app '$id' sem launch valido; voltando ao menu"; echo menu > "$MODE_FILE"; return
      ;;
  esac
  local pid=$!
  # o proprio app tira o loading quando estiver pronto (ex.: lasdpc-retroarch)
  if [ "$(app "$id" launch.manages_loading)" != "true" ]; then
    sleep "${LASDPC_APP_READY_DELAY:-1.8}"; hide_loading
  fi
  wait "$pid"
}

declare -A fails
now(){ date +%s; }

# Saida de audio: HDMI (a TV), a menos que AUDIO_OUTPUT=keep no station.conf.
# Sem isso o PipeWire pode escolher o conector de fone.
set_hdmi_audio(){
  load_env
  [ "${AUDIO_OUTPUT:-hdmi}" = "hdmi" ] || return 0
  local id
  id="$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -m1 'HDMI' | grep -oE '[0-9]+[.]' | head -1 | tr -d .)"
  [ -n "$id" ] && wpctl set-default "$id" 2>/dev/null || true
}

log "iniciado (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-?})"
# scopes de uma sessao anterior (ex.: reiniciada por atualizacao): encerra antes
# de abrir o app do modo atual, senao ele ficaria em dobro
systemctl --user stop 'lasdpc-app-*.scope' >/dev/null 2>&1 || true
set_hdmi_audio
while true; do
  MODE="$(read_mode)"
  ID="$(lasdpc-apps resolve "$MODE" 2>/dev/null || true)"
  if [ -z "$ID" ]; then
    log "modo '$MODE' nao e um app habilitado; voltando ao menu"
    echo menu > "$MODE_FILE"; sleep 1; continue
  fi
  load_env
  if [ "$(app "$ID" launch.type)" = "desktop" ]; then
    hide_loading
    notify-send -t 5000 -i dialog-information "LASDPC — Modo Desktop" \
      "Super+Esc → menu central\nBotão direito no desktop → opções" 2>/dev/null || true
    wait_until_mode_changes "$MODE"
    continue
  fi
  t0=$(now)
  run_app "$ID"
  # App saiu sozinho (fechou/caiu) e o modo nao mudou: "on_exit: menu" volta ao
  # menu; os demais (persistent: telas como Musica/AirPlay/Dashboard) relancam.
  if [ "$(read_mode)" = "$MODE" ] && [ "$(app "$ID" launch.on_exit)" = "menu" ]; then
    echo menu > "$MODE_FILE"
  fi
  dt=$(( $(now) - t0 ))
  if [ "$dt" -lt 5 ]; then
    fails[$ID]=$(( ${fails[$ID]:-0} + 1 ))
    if [ "${fails[$ID]}" -ge 5 ]; then
      log "app $ID falhou ${fails[$ID]}x rapido — caindo para o menu (backoff)"
      echo menu > "$MODE_FILE"; fails[$ID]=0; sleep 3
    else
      sleep 2
    fi
  else
    fails[$ID]=0
  fi
done
