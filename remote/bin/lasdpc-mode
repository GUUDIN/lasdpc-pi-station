#!/usr/bin/env bash
# ============================================================
# lasdpc-mode — máquina de estados de modos (mutuamente exclusivos).
#   lasdpc-mode dashboard | menu | media | games | desktop
# Escreve o modo e encerra APENAS os apps gerenciados pelo projeto.
# O runner da sessão (lasdpc-session, dentro da sessão gráfica) relança o app.
# Pode ser chamado por SSH: aqui só mexe em estado + processos (sem GUI).
# ============================================================
set -u
MODE_DIR="${HOME:-/home/lasdpc}/.config/lasdpc"
MODE_FILE="$MODE_DIR/mode"
mkdir -p "$MODE_DIR"

usage(){ echo "uso: lasdpc-mode {dashboard|menu|media|games|desktop}"; exit 1; }
[ $# -eq 1 ] || usage
NEW="$1"
case "$NEW" in dashboard|menu|media|games|desktop) ;; *) usage ;; esac

# Encerra apenas apps gerenciados (nunca killall genérico)
kill_managed() {
  # Chromium do kiosk (identificado pelo profile dedicado)
  pkill -f -- '--user-data-dir=.*/lasdpc/chromium-kiosk' 2>/dev/null || true
  # Kodi
  pkill -x kodi.bin 2>/dev/null || true; pkill -x kodi 2>/dev/null || true
  # EmulationStation
  pkill -x emulationstation 2>/dev/null || true
}

echo "$NEW" > "$MODE_FILE"
kill_managed
logger -t lasdpc-mode "modo alterado para: $NEW" 2>/dev/null || true
echo "Modo: $NEW (a sessão gráfica vai aplicar em instantes)."
