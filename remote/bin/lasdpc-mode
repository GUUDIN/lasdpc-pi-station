#!/usr/bin/env bash
# ============================================================
# lasdpc-mode <app> — troca o app em tela (modos mutuamente exclusivos).
#   lasdpc-mode menu | dashboard | youtube | spotify | games | airplay | desktop | ...
# Os modos sao os apps habilitados (lasdpc-apps ids; apelidos antigos como
# "musica" e "media" continuam valendo). Pode ser chamado por SSH.
# Grava o modo e encerra os OUTROS apps parando os scopes deles
# (lasdpc-app-<id>-N.scope, criados pelo lasdpc-session); servicos declarados
# no app.json (ex.: o receptor AirPlay) so ficam ligados no app dono deles.
# ============================================================
set -u
MODE_DIR="${HOME:-/home/lasdpc}/.config/lasdpc"
MODE_FILE="$MODE_DIR/mode"
mkdir -p "$MODE_DIR"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

usage(){ echo "uso: lasdpc-mode {$(lasdpc-apps ids 2>/dev/null | paste -sd'|')}"; exit 1; }
[ $# -eq 1 ] || usage
NEW="$(lasdpc-apps resolve "$1")" || usage
user_systemctl(){ systemctl --user "$@" >/dev/null 2>&1 || true; }

show_loading(){
  [ "$(lasdpc-apps get "$NEW" launch.type)" = "desktop" ] && return 0
  local msg="${LASDPC_LOADING_MSG:-$(lasdpc-apps get "$NEW" loading)}"
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" lasdpc-loading "${msg:-Carregando}" >/dev/null 2>&1 &
  # da tempo de o overlay cobrir a tela antes de fechar o app atual
  sleep "${LASDPC_LOADING_PREROLL:-0.8}"
}

# Para os scopes de todos os apps exceto o novo. O modo ja foi gravado antes:
# o lasdpc-session so le o modo quando o app atual sai, entao o scope do app
# novo ainda nao existe aqui (sem corrida).
stop_other_apps(){
  local unit
  systemctl --user list-units --type=scope --state=running --no-legend --plain 'lasdpc-app-*' 2>/dev/null \
    | awk '{print $1}' | while read -r unit; do
      case "$unit" in lasdpc-app-"$NEW"-*) ;; *) user_systemctl stop "$unit" ;; esac
    done
}

apply_services(){
  local mine unit
  mine=" $(lasdpc-apps get "$NEW" services) "
  for unit in $(lasdpc-apps services); do
    case "$mine" in *" $unit "*) user_systemctl start "$unit" ;; *) user_systemctl stop "$unit" ;; esac
  done
}

show_loading
echo "$NEW" > "$MODE_FILE"
stop_other_apps
apply_services
logger -t lasdpc-mode "modo alterado para: $NEW" 2>/dev/null || true
echo "Modo: $NEW (a sessão gráfica vai aplicar em instantes)."
