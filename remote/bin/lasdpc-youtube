#!/usr/bin/env bash
# ============================================================
# lasdpc-youtube — abre o YouTube TV (interface de TV, feita para controle
# remoto/teclado) em Chromium kiosk. Celular: Configuracoes > Vincular com codigo
# de TV, depois "Transmitir" no app do YouTube.
# Extensoes: escape (botao Menu), h264ify (H.264 -> decoder de hardware do Pi 4),
# uBlock Origin Lite (rastreadores/anuncios gerais) e ytads (remove os anuncios do
# player do YouTube TV, que o uBO Lite nao cobre).
# ============================================================
set -u

CONF_DIR="${HOME}/.config/lasdpc"
ENV_FILE="$CONF_DIR/session.env"
PROFILE="$CONF_DIR/chromium-youtube-tv"
ESCAPE_EXTENSION="/opt/lasdpc-pi-station/kiosk/escape-extension"
H264IFY_EXTENSION="/opt/lasdpc-pi-station/kiosk/h264ify-extension"
UBOL_EXTENSION="/opt/lasdpc-pi-station/kiosk/ubol"
YTADS_EXTENSION="/opt/lasdpc-pi-station/kiosk/ytads-extension"

YOUTUBE_TV_URL="https://www.youtube.com/tv"
YOUTUBE_TV_UA="Mozilla/5.0 (SMART-TV; Linux; Tizen 6.5) AppleWebKit/537.36 (KHTML, like Gecko) SamsungBrowser/5.0 TV Safari/537.36"

if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  . "$ENV_FILE"
fi

mkdir -p "$PROFILE"

CHROME=""
for c in chromium chromium-browser; do
  command -v "$c" >/dev/null 2>&1 && { CHROME="$c"; break; }
done
[ -n "$CHROME" ] || { logger -t lasdpc-youtube "Chromium nao encontrado"; sleep 5; exit 1; }

CHROME_ARGS=(
  --ozone-platform=wayland
  --user-data-dir="$PROFILE"
  --load-extension="$ESCAPE_EXTENSION,$H264IFY_EXTENSION,$UBOL_EXTENSION,$YTADS_EXTENSION"
  --kiosk "$YOUTUBE_TV_URL"
  --start-fullscreen
  # Decode de hardware: o Pi 4 so tem decoder H.264 (bcm2835-codec, /dev/video10)
  # e o h264ify garante que o YouTube sirva H.264. NAO passe --use-gl=egl nem
  # flags de AcceleratedVideoDecode*: no Chromium da Pi (wrapper ja usa
  # --use-angle=gles) elas desligavam o decoder -> 1080p por software, ~220% de
  # CPU e 15-50% de quadros perdidos. Com os padroes: ~25% de CPU, <1% perdidos.
  --noerrdialogs
  --disable-infobars
  --disable-session-crashed-bubble
  --disable-translate
  --disable-features=Translate,TranslateUI
  --lang=pt-BR
  --accept-lang=pt-BR,pt,en-US,en
  --no-first-run
  --fast
  --fast-start
  --no-default-browser-check
  --check-for-update-interval=31536000
  --overscroll-history-navigation=0
  --autoplay-policy=no-user-gesture-required
  --password-store=basic
)

if [ -n "${YOUTUBE_TV_UA:-}" ]; then
  CHROME_ARGS+=(--user-agent="$YOUTUBE_TV_UA")
fi

logger -t lasdpc-youtube "abrindo $YOUTUBE_TV_URL"
exec "$CHROME" "${CHROME_ARGS[@]}"
