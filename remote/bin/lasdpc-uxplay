#!/usr/bin/env bash
set -euo pipefail

CONF_DIR="${HOME}/.config/lasdpc"
ENV_FILE="$CONF_DIR/session.env"

UXPLAY_NAME="TV LASDPC $(hostname)"
# waylandsink: nativo Wayland, funciona com labwc. Override via UXPLAY_VIDEO_SINK em session.env.
UXPLAY_VIDEO_SINK="waylandsink"

if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  . "$ENV_FILE"
fi

# -s: solicita resolucao ao cliente; -nc: mantem janela ao desconectar
exec uxplay -n "$UXPLAY_NAME" -nh -vs "$UXPLAY_VIDEO_SINK" -fs -s 1920x1080@60 -nc
