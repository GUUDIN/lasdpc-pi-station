#!/usr/bin/env bash
set -euo pipefail

CONF_DIR="${HOME}/.config/lasdpc"
ENV_FILE="$CONF_DIR/session.env"

UXPLAY_NAME="TV LASDPC $(hostname)"
UXPLAY_VIDEO_SINK="waylandsink"

if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  . "$ENV_FILE"
fi

exec uxplay -n "$UXPLAY_NAME" -vs "$UXPLAY_VIDEO_SINK" -fs
