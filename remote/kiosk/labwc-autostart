# Autostart do labwc — LASDPC Station (usuário lasdpc).
# Mantém os componentes normais do desktop (painel/arquivos/kanshi) e
# adiciona o runner de sessão da estação por cima (modos dashboard/menu/media/games).
/usr/bin/lwrespawn /usr/bin/pcmanfm-pi &
/usr/bin/lwrespawn /usr/bin/wf-panel-pi &
/usr/bin/kanshi &
/usr/bin/lxsession-xdg-autostart
# Runner de modos da estação (kiosk/menu/kodi/es). Respawn próprio interno.
/usr/bin/lwrespawn /usr/local/bin/lasdpc-session &
