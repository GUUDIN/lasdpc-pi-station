# Autostart do usuário labwc — LASDPC Station.
# O Raspberry Pi OS já executa o autostart global em /etc/xdg/labwc/autostart
# com painel, desktop e kanshi. Aqui adicionamos apenas o runner da estação
# para não duplicar barras/desktop quando o desktop normal é usado.
/usr/bin/lwrespawn /usr/local/bin/lasdpc-session &
