# ============================================================
# Stack IoT — variáveis (copie para docker/.env, ignorado pelo Git).
# Gere senhas fortes: openssl rand -base64 24
# Nenhuma senha real deve ser versionada.
# ============================================================
TZ=America/Sao_Paulo

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE-ME-strong

# ---- InfluxDB 2 ----
INFLUX_USERNAME=admin
INFLUX_PASSWORD=CHANGE-ME-strong
INFLUX_ORG=lasdpc
INFLUX_BUCKET=iot
INFLUX_ADMIN_TOKEN=CHANGE-ME-long-random-token
INFLUX_RETENTION=30d

# ---- Mosquitto (sem anônimo) ----
MOSQUITTO_USERNAME=iot
MOSQUITTO_PASSWORD=CHANGE-ME-strong

# ---- Bind LAN (não expor à internet) ----
BIND_ADDRESS=0.0.0.0   # ajuste para o IP da LAN se quiser restringir ainda mais
