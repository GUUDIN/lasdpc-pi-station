# ============================================================
# LASDPC Pi Station — variáveis do projeto (NÃO COLOQUE SENHAS REAIS)
# Copie para .env e ajuste. O .env é ignorado pelo Git.
# Nunca escreva a senha da Pi aqui — a senha é digitada interativamente.
# ============================================================

# ---- Conexão SSH com a Raspberry Pi ----
PI_HOST=                      # IP ou hostname (ex.: 192.168.0.50 ou lasdpc-pi-display-01.local)
PI_USER=                      # usuário SSH (ex.: pi)
PI_PORT=22                    # porta SSH
PI_SSH_KEY=~/.ssh/id_ed25519  # caminho da chave privada (autenticação por chave recomendada)

# ---- Identidade do equipamento ----
PI_HOSTNAME=lasdpc-pi-display-01
PI_TIMEZONE=America/Sao_Paulo
PI_LOCALE=pt_BR.UTF-8
PI_KEYBOARD=br                # ABNT2

# ---- Dashboard / Kiosk ----
DASHBOARD_URL=                # URL exibida em modo kiosk (ex.: http://192.168.0.10:3000)
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_ORIENTATION=normal     # normal | left | right | inverted

# ---- Caminhos remotos padrão (não alterar sem motivo) ----
REMOTE_BASE=/opt/lasdpc-pi-station
REMOTE_DATA=/srv/lasdpc-pi-station
REMOTE_BACKUPS=/var/backups/lasdpc-pi-station
